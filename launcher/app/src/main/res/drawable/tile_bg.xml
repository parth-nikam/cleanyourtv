<?xml version="1.0" encoding="utf-8"?>
<!--
  Tile card (FORK, parth-nikam). The resting card for apps that have no full-bleed banner. Given the same
  glass language as the pills and dock: a dark base lifted by a faint top-lit gradient and a hairline rim,
  so an icon-only tile (Apple TV, 1001 TVs) reads as the same material as the rest of the UI instead of a
  flat grey box. Banner apps (Netflix, Prime) cover it, so this only shows where there is no artwork.
  18dp radius to sit between the pills' 22dp and the old 16dp, consistent across tile sizes.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FF2A2A2E"
        android:endColor="#FF161618" />
    <stroke android:width="1dp" android:color="#1FFFFFFF" />
    <corners android:radius="18dp" />
</shape>
