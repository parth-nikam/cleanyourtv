<?xml version="1.0" encoding="utf-8"?>
<!--
  Liquid-glass pill (FORK, parth-nikam). Each resting state is ONE cohesive glass surface: a single
  top-to-bottom gradient that is brightest at the very top edge (the glass catching light) and eases down
  into a faint translucent body, plus a hairline rim. The sheen IS the fill - not a second rounded box
  stacked on top, which is what made the old version look like a strip floating above the pill. No real
  blur (too costly on the Realtek GPU); the gradient + rim read as glass at TV distance. Radius 22dp.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused: a bright, near-solid glass lozenge. One gradient from pure white at the top easing to a
         slightly softer white, so it still reads as a lit glass surface, not flat paint. -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFFFFFFF"
                android:endColor="#F0FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- Resting glass: a single gradient, bright specular lip at the top fading through a translucent body
         to a faint foot, with a hairline rim. One shape, so there is no inner seam. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#4DFFFFFF"
                android:centerColor="#1FFFFFFF"
                android:endColor="#0FFFFFFF"
                android:centerY="0.28" />
            <stroke android:width="1dp" android:color="#45FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
