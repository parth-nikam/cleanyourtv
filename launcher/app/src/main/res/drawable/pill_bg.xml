<?xml version="1.0" encoding="utf-8"?>
<!--
  Liquid-glass pill (FORK, parth-nikam). Each state is a layer-list: a translucent base fill, a bright
  specular highlight band across the top third (the "glass catching light"), and a hairline rim. No real
  blur (too expensive on this Realtek GPU) - the layered translucency + top sheen read as glass at TV
  distance. Radius lifted to 22dp for the softer Apple lozenge.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused: a bright, almost-solid glass lozenge, still with a top sheen so it reads as lit glass. -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#F2FFFFFF" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item android:height="20dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#FFFFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- Resting glass: translucent base, a specular sheen band on top, a hairline rim. -->
    <item>
        <layer-list>
            <!-- Base fill: brighter at the top, fading down, like light pooling in the glass. -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#3DFFFFFF"
                        android:centerColor="#1FFFFFFF"
                        android:endColor="#14FFFFFF" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <!-- Specular highlight across the top third: the glass edge catching light. -->
            <item android:height="16dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#5CFFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <!-- Hairline rim: a crisp bright edge so the lozenge has a defined glass border. -->
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="#4DFFFFFF" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
