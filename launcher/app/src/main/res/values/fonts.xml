<?xml version="1.0" encoding="utf-8"?>
<!-- The UI fonts, looked up through these strings so a locale can swap in a system family: the bundled
     face has no glyphs for most Vietnamese accented letters, so values-vi points them at the system
     sans-serif (#833).
     FORK (parth-nikam): the UI face is Manrope (OFL), a more refined geometric sans than Outfit, swapped
     in across the whole launcher by repointing these strings. See launcher/FONT-LICENSE-MANROPE-OFL.txt. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ReferenceType">
    <string name="font_body" translatable="false">@font/manrope</string>
    <string name="font_regular" translatable="false">@font/manrope_regular</string>
    <string name="font_light" translatable="false">@font/manrope_light</string>
    <string name="font_extralight" translatable="false">@font/manrope_extralight</string>
    <string name="font_medium" translatable="false">@font/manrope_medium</string>
</resources>
